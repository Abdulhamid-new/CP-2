<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
// ============================================================
// 💾 localStorage YORDAMIDA DOIMIY SAQLASH TIZIMI
// ============================================================

const LS = {
  get(key, def) {
    try { const v = localStorage.getItem('shif_' + key); return v ? JSON.parse(v) : def; } catch(e) { return def; }
  },
  set(key, val) {
    try { localStorage.setItem('shif_' + key, JSON.stringify(val)); } catch(e) { console.warn('localStorage error', e); }
  }
};

// === SOAT ===
function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent =
    now.toLocaleTimeString('uz-UZ', {hour:'2-digit', minute:'2-digit'});
  document.getElementById('dateline').textContent =
    now.toLocaleDateString('uz-UZ', {weekday:'long', year:'numeric', month:'long', day:'numeric'});
}
updateClock(); setInterval(updateClock, 1000);

// === NAVIGATSIYA ===
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(item => {
    if (item.getAttribute('onclick') && item.getAttribute('onclick').includes("'" + id + "'"))
      item.classList.add('active');
  });
  window.scrollTo({top:0, behavior:'smooth'});
  LS.set('lastPage', id);
}

// === BO'SH NAVBAT VA BEMORLAR RO'YXATI ===
const colorMap = {'LOR':'tag-teal','Nevrologiya':'tag-blue','Kardiologiya':'tag-red','UVCh':'tag-yellow',
  'Burun yuvish':'tag-green','Kunduzgi muolaja':'tag-green',"Qayta ko'ruv":'tag-blue','Laboratoriya':'tag-yellow','TUBS':'tag-teal'};
const statusColor = {'Tugadi':'tag-green','Jarayonda':'tag-yellow','Navbatda':'tag-blue','Kurs':'tag-teal',"Qayta ko'ruv":'tag-blue'};

let queueData = LS.get('queue', []);
let patients = LS.get('patients', []);

function renderQueue() {
  const el = document.getElementById('queue-list');
  el.innerHTML = queueData.length === 0
    ? '<div style="padding:24px;text-align:center;color:#7a8899">Navbatda hech kim yo\'q</div>'
    : queueData.map(q => `
    <div class="queue-item">
      <div class="queue-num">${q.num}</div>
      <div class="queue-info">
        <div class="queue-name">${q.name}</div>
        <div class="queue-detail"><span class="tag ${colorMap[q.dept]||'tag-teal'}" style="font-size:10px">${q.dept}</span> · ${q.doctor}</div>
      </div>
      <div class="queue-time">⏰ ${q.time}</div>
    </div>`).join('');
  document.getElementById('queue-badge').textContent = queueData.length;
}

function renderPatients(list) {
  document.getElementById('patients-body').innerHTML = list.length === 0
    ? '<tr><td colspan="7" style="text-align:center;color:#7a8899;padding:24px">Bemorlar ro\'yxati bo\'sh</td></tr>'
    : list.map(p => `
    <tr>
      <td>${p.id}</td><td>${p.name}</td><td>${p.age||'—'}</td>
      <td>${p.dept}</td><td>${p.last}</td>
      <td><span class="tag ${statusColor[p.status]||'tag-blue'}">${p.status}</span></td>
      <td><button class="btn-icon" title="O'chirish" onclick="deletePatient('${p.id}')">🗑️</button></td>
    </tr>`).join('');
    
  updateDashboardStats();
}

function filterPatients(q) {
  const filtered = patients.filter(p =>
    p.name.toLowerCase().includes(q.toLowerCase()) || p.id.includes(q) || (p.dept||'').toLowerCase().includes(q.toLowerCase())
  );
  renderPatients(filtered);
}

function deletePatient(id) {
  if (!confirm('Ushbu bemorni butunlay o\'chirib tashlashni xohlaysizmi?')) return;
  
  const target = patients.find(p => p.id === id);
  
  // Bemorni patients dan o'chirish
  patients = patients.filter(p => p.id !== id);
  LS.set('patients', patients);
  
  // Bemorni queue dan o'chirish (agar ism bilan ulanish bo'lsa)
  if (target) {
    queueData = queueData.filter(q => q.name !== target.name);
    // Navbat raqamlarini yangilash
    queueData.forEach((q, idx) => { q.num = idx + 1; });
    LS.set('queue', queueData);
  }
  
  renderPatients(patients);
  renderQueue();
  toast('Bemor o\'chirildi 🗑️');
}

function updateDashboardStats() {
  const today = new Date().toLocaleDateString('uz-UZ').replace(/\//g,'.');
  const todayPatients = patients.filter(p => p.last === today);
  const navbatda = patients.filter(p => p.status === 'Navbatda').length;
  const qayta = patients.filter(p => p.status === "Qayta ko'ruv").length;
  const tugadi = patients.filter(p => p.status === 'Tugadi' && p.last === today).length;
  
  // Dashborddagi stat kartochkalari
  document.getElementById('dash-stat-1').textContent = todayPatients.length || patients.length;
  document.getElementById('dash-stat-2').textContent = tugadi;
  document.getElementById('dash-stat-3').textContent = navbatda;
  document.getElementById('dash-stat-4').textContent = qayta;
  
  // So'nggi bemorlar ro'yxatini dashboard ga chiqarish
  const recentTable = document.getElementById('dash-latest-patients');
  if (patients.length === 0) {
    recentTable.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#7a8899">Ma\'lumot topilmadi</td></tr>';
  } else {
    // Eng oxirgi qo'shilgan 5 ta bemor
    recentTable.innerHTML = [...patients].reverse().slice(0, 5).map((p, idx) => `
      <tr>
        <td>${idx+1}</td>
        <td>${p.name}</td>
        <td>${p.dept}</td>
        <td>—</td>
        <td>${p.last}</td>
        <td><span class="tag ${statusColor[p.status]||'tag-blue'}">${p.status}</span></td>
      </tr>
    `).join('');
  }
}

// === BEMOR QO'SHISH ===
function registerPatient() {
  const ln = document.getElementById('r-lastname').value.trim();
  const fn = document.getElementById('r-firstname').value.trim();
  const fa = document.getElementById('r-fathername').value.trim();
  const dob = document.getElementById('r-dob').value;
  const phone = document.getElementById('r-phone').value.trim();
  const dept = document.getElementById('r-dept').value;
  const reason = document.getElementById('r-reason').value.trim();
  const note = document.getElementById('r-note').value.trim();

  if (!ln || !fn || !dept) { toast('⚠️ Familiya, ism va bo\'lim majburiy'); return; }

  let age = '—';
  if (dob) {
    const birthYear = new Date(dob).getFullYear();
    age = new Date().getFullYear() - birthYear;
  }

  const today = new Date().toLocaleDateString('uz-UZ').replace(/\//g,'.');
  const newId = 'B-' + String(patients.length + 1).padStart(3, '0');

  const newP = {
    id: newId,
    name: ln + ' ' + fn + (fa ? ' ' + fa : ''),
    age,
    dept: dept.split(' (')[0],
    phone,
    dob,
    reason,
    note,
    last: today,
    status: 'Navbatda',
    registeredAt: new Date().toISOString()
  };

  patients.push(newP);
  LS.set('patients', patients);

  const now = new Date();
  const timeStr = now.toLocaleTimeString('uz-UZ', {hour:'2-digit', minute:'2-digit'});
  queueData.push({
    num: queueData.length + 1,
    name: newP.name,
    dept: newP.dept,
    doctor: document.getElementById('r-ref').value.split(' ')[0],
    time: timeStr
  });
  LS.set('queue', queueData);

  renderPatients(patients);
  renderQueue();
  toast('✅ ' + newP.name + ' ro\'yxatga qo\'shildi');
  clearForm();
  setTimeout(() => showPage('patients'), 1000);
}

function clearForm() {
  ['r-lastname','r-firstname','r-fathername','r-phone','r-reason','r-note'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.getElementById('r-dob').value = '';
  document.getElementById('r-dept').value = '';
  document.getElementById('price-group').style.display = 'none';
}

function updatePrice() {
  const sel = document.getElementById('r-dept');
  const opt = sel.options[sel.selectedIndex];
  const price = opt ? opt.getAttribute('data-price') : '';
  const group = document.getElementById('price-group');
  const display = document.getElementById('price-display');
  
  if (!sel.value) { group.style.display = 'none'; return; }
  
  group.style.display = 'flex';
  
  if (price) {
    display.innerHTML = price + " so'm";
    display.style.background = 'linear-gradient(135deg,#e6f7ee,#d4f0ee)';
    display.style.color = '#0a5459';
    display.style.padding = '10px 14px';
  } else {
    display.innerHTML = '<input type="text" placeholder="Narxni yozing..." style="width: 100%; border: none; background: transparent; font-size: 16px; font-weight: 700; color: inherit; outline: none;">';
    display.style.background = 'linear-gradient(135deg,#fff8e6,#fdf0e0)';
    display.style.color = '#7a5a00';
    display.style.padding = '8px 14px';
  }
}

// === TOZALASH ===
function clearAllData() {
  if (!confirm('⚠️ Barcha ma\'lumotlar o\'chiriladi! Davom etasizmi?')) return;
  localStorage.clear();
  location.reload();
}

// === TOAST ===
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2800);
}

// === ILOVANI ISHGA TUSHIRISH ===
function init() {
  renderPatients(patients);
  renderQueue();
  const lastPage = LS.get('lastPage', 'dashboard');
  showPage(lastPage);
}

init();
</script>
