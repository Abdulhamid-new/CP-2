  {id:'B-001', name:'Xasanov Jamshid', age:34, dept:'LOR', phone:'', dob:'', reason:'', last:'06.06.2026', status:'Tugadi'},
  {id:'B-002', name:'Toshmatova Gulnora', age:41, dept:'Nevrologiya', phone:'', dob:'', reason:'', last:'06.06.2026', status:'Jarayonda'},
