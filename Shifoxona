];

let patients = LS.get('patients', DEFAULT_PATIENTS);

const statusColor = {'Tugadi':'tag-green','Jarayonda':'tag-yellow','Navbatda':'tag-blue','Kurs':'tag-teal',"Qayta ko'ruv":'tag-blue'};

function renderPatients(list) {
  document.getElementById('patients-body').innerHTML = list.length === 0
    ? '<tr><td colspan="6" style="text-align:center;color:#7a8899;padding:24px">Bemorlar ro\'yxati bo\'sh</td></tr>'
    : list.map(p => `
    <tr>
      <td>${p.id}</td><td>${p.name}</td><td>${p.age||'—'}</td>
      <td>${p.dept}</td><td>${p.last}</td>
      <td><span class="tag ${statusColor[p.status]||'tag-blue'}">${p.status}</span></td>
    </tr>`).join('');
  // Dashboard statistikasini yangilash
  updateDashboardStats();
}

function filterPatients(q) {
  const filtered = patients.filter(p =>
    p.name.toLowerCase().includes(q.toLowerCase()) || p.id.includes(q) || (p.dept||'').toLowerCase().includes(q.toLowerCase())
  );
  renderPatients(filtered);
}

function updateDashboardStats() {
  const today = new Date().toLocaleDateString('uz-UZ').replace(/\//g,'.');
  const todayPatients = patients.filter(p => p.last === today);
  const navbatda = patients.filter(p => p.status === 'Navbatda').length;
  const qayta = patients.filter(p => p.status === "Qayta ko'ruv").length;
  const tugadi = patients.filter(p => p.status === 'Tugadi' && p.last === today).length;
  // Stat kartlarini yangilash (dashboard)
  const cards = document.querySelectorAll('#page-dashboard .stat-card .value');
  if (cards[0]) cards[0].textContent = todayPatients.length || patients.length;
  if (cards[1]) cards[1].textContent = tugadi;
  if (cards[2]) cards[2].textContent = navbatda;
  if (cards[3]) cards[3].textContent = qayta;
}

// === BEMOR QO'SHISH ===
function registerPatient() {
  const ln = document.getElementById('r-lastname').value.trim();
  const fn = document.getElementById('r-firstname').value.trim();
  const fa = document.getElementById('r-fathername').value.trim();
  const dob = document.getElementById('r-dob').value;
  const phone = document.getElementById('r-phone').value.trim();
  const dept = document.getElementById('r-dept').value;
  const reason = document.getElementById('r-reason').value.trim();
  const note = document.getElementById('r-note').value.trim();

  if (!ln || !fn || !dept) { toast('⚠️ Familiya, ism va bo\'lim majburiy'); return; }

  // Yosh hisoblash
  let age = '—';
  if (dob) {
    const birthYear = new Date(dob).getFullYear();
    age = new Date().getFullYear() - birthYear;
  }

  const today = new Date().toLocaleDateString('uz-UZ').replace(/\//g,'.');
  const newId = 'B-' + String(patients.length + 1).padStart(3, '0');

  const newP = {
    id: newId,
    name: ln + ' ' + fn + (fa ? ' ' + fa : ''),
    age,
    dept: dept.split(' (')[0],
    phone,
    dob,
    reason,
    note,
    last: today,
    status: 'Navbatda',
    registeredAt: new Date().toISOString()
  };

  patients.push(newP);
  LS.set('patients', patients); // 💾 localStorage ga saqlash

  // Navbatga qo'shish
  const now = new Date();
  const timeStr = now.toLocaleTimeString('uz-UZ', {hour:'2-digit', minute:'2-digit'});
  queueData.push({
    num: queueData.length + 1,
    name: newP.name,
    dept: newP.dept,
    doctor: document.getElementById('r-ref').value.split(' ')[0],
    time: timeStr
  });
  LS.set('queue', queueData); // 💾 navbatni ham saqlash

  renderPatients(patients);
  renderQueue();
  toast('✅ ' + newP.name + ' ro\'yxatga qo\'shildi va saqlandi');
  clearForm();
  setTimeout(() => showPage('patients'), 1200);
}

function clearForm() {
  ['r-lastname','r-firstname','r-fathername','r-phone','r-reason','r-note'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.getElementById('r-dob').value = '';
  document.getElementById('r-dept').value = '';
  document.getElementById('price-group').style.display = 'none';
}

// === NARXLAR — SAQLASH VA YUKLASH ===
const PRICE_FIELDS = ['p-lor','p-nevro','p-kardio','p-burun','p-uvch','p-tubs',
  'p-kund-tomchi','p-kund-im','p-kund-sc','p-qayta-lor','p-qayta-nevro','p-qayta-kardio',
  'n-lor','n-nevro','n-kardio','n-burun','n-uvch','n-tubs',
  'n-kund-tomchi','n-kund-im','n-kund-sc','n-qayta-lor','n-qayta-nevro','n-qayta-kardio'];

function loadPrices() {
  const saved = LS.get('prices', {});
  PRICE_FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (el && saved[id] !== undefined) el.value = saved[id];
  });
  // Lab qatorlarini yuklash
  const labRows = LS.get('lab_rows', []);
  if (labRows.length > 0) {
    const tbody = document.getElementById('lab-tbody');
    tbody.innerHTML = '';
    labRows.forEach((row, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td style="color:#7a8899;font-size:13px">${i+1}</td>
        <td><input class="price-note" type="text" placeholder="Tahlil nomi..." value="${row.name||''}"></td>
        <td><input class="price-input" type="number" placeholder="Narx kiriting..." min="0" value="${row.price||''}"></td>
        <td><input class="price-note" type="text" placeholder="Izoh..." value="${row.note||''}"></td>
        <td><button onclick="removeLabRow(this)" style="background:none;border:none;cursor:pointer;color:#d94f4f;font-size:16px">✕</button></td>`;
      tbody.appendChild(tr);
    });
    labRowCount = labRows.length;
  }
}

function saveSection(section) {
  const names = {doctors:'Shifokorlar narxi', muolaja:'Muolaja narxlari', lab:'Laboratoriya narxlari', qayta:"Qayta ko'ruv narxlari"};
  // Barcha narx maydonlarini saqlash
  const saved = LS.get('prices', {});
  PRICE_FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (el) saved[id] = el.value;
  });
  LS.set('prices', saved);

  // Lab qatorlarini alohida saqlash
  if (section === 'lab') {
    const tbody = document.getElementById('lab-tbody');
    const rows = Array.from(tbody.rows).map(tr => ({
      name: tr.cells[1].querySelector('input').value,
      price: tr.cells[2].querySelector('input').value,
      note: tr.cells[3].querySelector('input').value,
    }));
    LS.set('lab_rows', rows);
  }

  toast('✅ ' + (names[section]||'Narxlar') + ' saqlandi 💾');
}

let labRowCount = 3;

function addLabRow() {
  labRowCount++;
  const tbody = document.getElementById('lab-tbody');
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td style="color:#7a8899;font-size:13px">${tbody.rows.length + 1}</td>
    <td><input class="price-note" type="text" placeholder="Tahlil nomi..."></td>
    <td><input class="price-input" type="number" placeholder="Narx kiriting..." min="0"></td>
    <td><input class="price-note" type="text" placeholder="Izoh..."></td>
    <td><button onclick="removeLabRow(this)" style="background:none;border:none;cursor:pointer;color:#d94f4f;font-size:16px">✕</button></td>`;
  tbody.appendChild(tr);
}

function removeLabRow(btn) {
  const tbody = document.getElementById('lab-tbody');
  if (tbody.rows.length <= 1) { toast('⚠️ Kamida 1 ta qator bo\'lishi kerak'); return; }
  btn.closest('tr').remove();
  Array.from(tbody.rows).forEach((r, i) => { r.cells[0].textContent = i + 1; });
}

// === NARX KO'RSATISH (BEMOR QOSHISH FORMASI) ===
function updatePrice() {
  const sel = document.getElementById('r-dept');
  const opt = sel.options[sel.selectedIndex];
  const price = opt ? opt.getAttribute('data-price') : '';
  const group = document.getElementById('price-group');
  const display = document.getElementById('price-display');
  if (!sel.value) { group.style.display = 'none'; return; }
  group.style.display = 'flex';
  if (price) {
    display.textContent = price + " so'm";
    display.style.background = 'linear-gradient(135deg,#e6f7ee,#d4f0ee)';
    display.style.color = '#0a5459';
  } else {
    display.textContent = 'Narx turlicha — kassada aniqlanadi';
    display.style.background = 'linear-gradient(135deg,#fff8e6,#fdf0e0)';
    display.style.color = '#7a5a00';
  }
}

// === MA'LUMOTLARNI TOZALASH (EHTIYOT UCHUN) ===
function clearAllData() {
  if (!confirm('⚠️ Barcha ma\'lumotlar o\'chiriladi! Davom etasizmi?')) return;
  localStorage.clear();
  location.reload();
}

// === TOAST ===
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2800);
}

// === ILOVANI ISHGA TUSHIRISH ===
function init() {
  renderPatients(patients);
  renderQueue();
  loadPrices();
  // Oxirgi ochiq sahifani tiklash
  const lastPage = LS.get('lastPage', 'dashboard');
  showPage(lastPage);
  // Saqlangan ma'lumotlar haqida xabar
  const savedCount = patients.length - DEFAULT_PATIENTS.length;
  if (savedCount > 0) {
    setTimeout(() => toast('💾 ' + patients.length + ' ta bemor localStorage dan yuklandi'), 500);
  }
}

init();
</script>
